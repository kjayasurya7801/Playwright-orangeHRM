{
  "compilerOptions": {
    "target": "ES2021",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "config",
    "src",
    "tests",
    "playwright.config.ts"
  ]
}